# ============================================================
# HiveQuote environment configuration
# Public marketing pages may run without integrations, but operational
# auth/payment/routing/webhook paths fail closed until required keys exist.
# ============================================================

# --- Supabase (database, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (all payments: wallets, ACH, subscriptions) ---
# Product naming rule: "Lead Generation Service", "Lead Generation Subscription",
# "Contractor Platform Setup", "Lead Wallet Funding" ONLY. Never "success fee",
# "referral fee", "performance fee", or "introduction fee".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- GoHighLevel (CRM, SMS, pipelines) ---
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Twilio (delivery receipts, call tracking fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Internal automation ingress (n8n/Make/private workers only) ---
# Generate a high-entropy value and provision it separately to each authorized runtime.
HIVEQUOTE_INTERNAL_WEBHOOK_SECRET=

# --- SMS gate: keep false until A2P 10DLC registration is APPROVED ---
SMS_ACTIVE=false

# --- Legacy admin API gate; replace with role-based Supabase Auth before go-live ---
ADMIN_ACCESS_KEY=change-me

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://hivequote.com
