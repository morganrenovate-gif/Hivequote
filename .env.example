# HiveQuote environment configuration
# Hedy is the authoritative backend. Missing integrations fail closed.

# Hedy backend
HEDY_BACKEND_ORIGIN=
HEDY_ENVIRONMENT=staging

# Stripe remains disabled until separately governed activation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# GoHighLevel remains disabled until signed/idempotent Hedy integration is activated.
GHL_API_KEY=
GHL_LOCATION_ID=

# Twilio remains disabled until signed Hedy ingress is activated.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS stays false until compliance and provider gates are approved.
SMS_ACTIVE=false

# Temporary Next.js admin API gate; operational admin data remains unavailable.
ADMIN_ACCESS_KEY=

# Public site
NEXT_PUBLIC_SITE_URL=https://hivequote.com
